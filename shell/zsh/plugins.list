# Oh My Zsh compatibility layer
getantidote/use-omz

# ============================================================
# CORE ESSENTIALS
# ============================================================
zsh-users/zsh-autosuggestions           # Fish-like suggestions as you type
zsh-users/zsh-completions               # Additional completions for common tools
zdharma-continuum/fast-syntax-highlighting  # Fast, accurate syntax highlighting
hlissner/zsh-autopair                   # Auto-close quotes and brackets

# ============================================================
# PRODUCTIVITY & INTERACTIVE TOOLS
# ============================================================
Aloxaf/fzf-tab                          # Replace completion menu with fzf
wfxr/forgit                             # Interactive Git powered by fzf & delta
paulirish/git-open                      # Open GitHub/GitLab repo/PR in browser
MichaelAquilina/zsh-you-should-use      # Reminds you of existing aliases

# ============================================================
# OH MY ZSH CURATED UTILITIES
# ============================================================
ohmyzsh/ohmyzsh path:plugins/sudo       # Double-tap ESC to prepend sudo
ohmyzsh/ohmyzsh path:plugins/extract    # Universal archive extractor (x command)
ohmyzsh/ohmyzsh path:plugins/copypath   # Copy current directory path
ohmyzsh/ohmyzsh path:plugins/copyfile   # Copy file contents to clipboard
ohmyzsh/ohmyzsh path:plugins/web-search # Search web from terminal
ohmyzsh/ohmyzsh path:plugins/git        # Core git functions & completions
ohmyzsh/ohmyzsh path:plugins/gitignore  # Generate .gitignore files via gi
ohmyzsh/ohmyzsh path:plugins/docker     # Docker CLI completions & helpers
ohmyzsh/ohmyzsh path:plugins/macos      # macOS commands (ofd, cdf, trash)
